<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the real McpHttpServer with a fake tool provider, outside Visual Studio, for fast protocol checks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VsMcp.Harness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\VsMcp.Vsix\Mcp\*.cs" Link="Mcp\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\VsMcp.Vsix\Contracts\*.cs" Link="Contracts\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" Version="2.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
  </ItemGroup>

</Project>
