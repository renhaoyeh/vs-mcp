<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.4.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" Version="2.3.0" />
    <Compile Include="../VsMcp.Vsix/Contracts/*.cs" Link="Contracts/%(Filename)%(Extension)" />
    <Compile Include="../VsMcp.Vsix/Infrastructure/InstanceRegistry.cs" Link="Infrastructure/InstanceRegistry.cs" />
    <EmbeddedResource Include="tools.json" />
    <InternalsVisibleTo Include="VsMcp.BridgeTests" />
    <InternalsVisibleTo Include="VsMcp.IntegrationTests" />
  </ItemGroup>
</Project>
